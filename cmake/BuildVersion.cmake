# Writes OUT (twv_build_version.h) with the app version and the source commit, for the settings
# page footer and the build_version receipt. Run at every build (cmake -P); the file is rewritten
# only when its text changes, so an unchanged commit recompiles nothing. The commit comes from
# SRC/build_commit.txt when present (tools/vita_build.sh writes it: the build's mirror has no .git),
# else from git. A tree with uncommitted changes is marked "+changes"; without either, "unknown".
#   cmake -DOUT=... -DSRC=... -DVERSION=00.01 -P BuildVersion.cmake
set(commit "")
set(date "")
set(changes "")
if (EXISTS "${SRC}/build_commit.txt")
    file(STRINGS "${SRC}/build_commit.txt" lines LIMIT_COUNT 3)
    list(LENGTH lines count)
    if (count GREATER 0)
        list(GET lines 0 commit)
    endif ()
    if (count GREATER 1)
        list(GET lines 1 date)
    endif ()
    if (count GREATER 2)
        list(GET lines 2 changes)
    endif ()
else ()
    execute_process(COMMAND git -C "${SRC}" rev-parse --short=8 HEAD
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git -C "${SRC}" log -1 --format=%cs
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git -C "${SRC}" -c core.fileMode=false status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
endif ()
if (NOT commit MATCHES "^[0-9a-f]+$")
    set(commit "unknown")
    set(date "")
    set(changes "")
endif ()
set(text "DuskOnVita ${VERSION} build ${commit}")
if (NOT changes STREQUAL "")
    string(APPEND text "+changes")
endif ()
if (date MATCHES "^[0-9-]+$")
    string(APPEND text " (${date})")
endif ()
set(content "// Generated by cmake/BuildVersion.cmake; do not edit.\n#define TWV_BUILD_VERSION \"${text}\"\n")
if (EXISTS "${OUT}")
    file(READ "${OUT}" old)
else ()
    set(old "")
endif ()
if (NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif ()
