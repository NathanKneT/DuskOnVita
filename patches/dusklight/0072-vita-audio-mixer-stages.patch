Vita, measurement only: the sound mixer's time by stage. On the console on 13 Nov, in Hyrule Field the
mixer (DspRender) takes 7.2 ms of each 10.7 ms device buffer with 39 voices active, 0.14 to
0.20 ms per voice and buffer in every place, and a quarter of the field's buffers are late. One
subframe in sixteen now times a voice's decode, resampling and filter, its volume and panning,
its reverb input and surround share, its mix into the output, and the reverb and the rest after
the voices, and counts the voices, those with the biquad filter on and the input samples asked
for. Reported through platform/vita/audio/audio_out.cpp.

--- a/src/dusk/audio/DuskDsp.cpp
+++ b/src/dusk/audio/DuskDsp.cpp
@@ -804,6 +804,24 @@ void dusk::audio::DspInit() {
     SharedReverb.mute();
 }
 
+#if TARGET_VITA
+// Measurement only (platform/vita/audio/audio_out.cpp): one subframe in sixteen reports the
+// mixer's time by stage (a voice's decode, resampling and filter; its volume and panning; its
+// reverb input and surround share; its mix into the output; then the reverb and the rest after
+// the voices), the voices rendered, those with the biquad filter on, and the input samples their
+// pitch asks for.
+extern "C" unsigned long long twv_vita_audio_clock_us(void);
+extern "C" void twv_vita_audio_mix_split(const unsigned* us, unsigned voices, unsigned biquads, unsigned inputSamples);
+#define TWV_MIX_STEP(n)                                                    \
+    if (twvTimed) {                                                        \
+        const unsigned long long twvNow = twv_vita_audio_clock_us();       \
+        twvUs[n] += static_cast<unsigned>(twvNow - twvT);                  \
+        twvT = twvNow;                                                     \
+    }
+#else
+#define TWV_MIX_STEP(n)
+#endif
+
 void dusk::audio::DspRender(OutputSubframe& subframe) {
     ZoneScoped;
     if (DumpAudio != sDumpWasActive) {
@@ -818,6 +836,13 @@ void dusk::audio::DspRender(OutputSubframe& subframe) {
