Vita: the tick's input step split into its parts (twv_vita_input_mark, platform/vita/gfx_vgl/
profile_hooks.cpp). The console session of 10 Nov measured the input step at 1.50 ms per game tick in
every place, without saying which of its calls costs it. Each mark reads the clock once; the
platform adds the time since the previous mark to a receipt: tick set-up, touch-control sync,
PADRead, action bindings, pad state update, pad conversion, mouse and gyro, combos. Without the
platform hook the marks do nothing. No game behaviour changes.

--- a/libs/JSystem/src/JUtility/JUTGamePad.cpp
+++ b/libs/JSystem/src/JUtility/JUTGamePad.cpp
@@ -8,6 +8,8 @@
 #include "dusk/action_bindings.h"
 #if TARGET_VITA
 extern "C" void twv_vita_benchmark_pad(PADStatus*) __attribute__((weak));
+// patches/dusklight/0055 (see m_Do_main.cpp): steps 3 to 5 of the tick's input step.
+extern "C" void twv_vita_input_mark(int step) __attribute__((weak));
 #endif
 #endif
 
@@ -93,9 +95,13 @@ DUSK_GAME_DATA u32 JUTGamePad::sRumbleSupported;
 u32 JUTGamePad::read() {
     sRumbleSupported = PADRead(mPadStatus);
 #if TARGET_PC
+#if TARGET_VITA
+   if (twv_vita_input_mark) twv_vita_input_mark(3);
+#endif
    dusk::updateActionBindings();
 #if TARGET_VITA
    if (twv_vita_benchmark_pad) twv_vita_benchmark_pad(mPadStatus);
+   if (twv_vita_input_mark) twv_vita_input_mark(4);
 #endif
 #endif
 
@@ -172,6 +178,9 @@ u32 JUTGamePad::read() {
     }
 
     checkResetSwitch();
+#if TARGET_PC && TARGET_VITA
+    if (twv_vita_input_mark) twv_vita_input_mark(5);
+#endif
     return sRumbleSupported;
 }
 
