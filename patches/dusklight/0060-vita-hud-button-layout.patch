+// HUD button arrangement, setting game.hudButtonLayout: "original" (the GameCube's: B at the lower
+// left of A, X at its right) or "vita": the B group and the X group of the main HUD trade places, so
+// that with A on cross, B on circle and X on square the icons sit as the buttons do on the Vita
+// (square left, circle right, triangle on top). When circle confirms (A on circle, B on cross) the
+// original arrangement already has the cross below and left of the circle, and is kept. Presentation
+// only: the pad mapping and what each button does are untouched.
+inline bool hud_trades_b_and_x() {
+    if (getSettings().game.hudButtonLayout.getValue() != "vita") {
+        return false;
+    }
+#if TARGET_VITA
+    return twv_vita_confirm_circle() == 0;
+#else
+    return true;
+#endif
+}
+
+// Receipt of what the HUD did (twilight-vita: platform/vita/ui/ps_glyphs.cpp).
+inline void hud_layout_done(bool traded, float dx, float dy) {
+#if TARGET_VITA
+    twv_hud_button_layout(traded ? 1 : 0, dx, dy);
+#else
+    (void)traded;
+    (void)dx;
+    (void)dy;
+#endif
+}
