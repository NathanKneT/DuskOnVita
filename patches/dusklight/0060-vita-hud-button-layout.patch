     init();
+#if TARGET_PC
+    // game.hudButtonLayout=vita: the B button and the X button trade places (dusk/button_prompts.hpp).
+    // Each button is three children of the button parent: the letter, the item and the action text;
+    // each B pane goes where its X counterpart was and the reverse, by the distance between the
+    // two read from the layout itself. The item panes are only shown and hidden, so they move here
+    // once; the letter and text panes are placed on every draw from their manager's start position,
+    // so that start position moves.
+    {
+        J2DPane* itemB = mpScreen->search(MULTI_CHAR('item_b_n'));
+        J2DPane* itemX = mpScreen->search(MULTI_CHAR('item_x_n'));
+        const bool trade = dusk::button_prompts::hud_trades_b_and_x() && itemB != NULL && itemX != NULL;
+        f32 dx = 0.0f;
+        f32 dy = 0.0f;
+        if (trade) {
+            dx = itemX->getTranslateX() - itemB->getTranslateX();
+            dy = itemX->getTranslateY() - itemB->getTranslateY();
+            itemB->translate(itemB->getTranslateX() + dx, itemB->getTranslateY() + dy);
+            itemX->translate(itemX->getTranslateX() - dx, itemX->getTranslateY() - dy);
+            CPaneMgr* const pairs[2][2] = {{mpButtonB, mpButtonXY[0]}, {mpTextB, mpTextXY[0]}};
+            for (CPaneMgr* const* pair : pairs) {
+                const f32 px = pair[1]->getPanePtr()->getTranslateX() - pair[0]->getPanePtr()->getTranslateX();
+                const f32 py = pair[1]->getPanePtr()->getTranslateY() - pair[0]->getPanePtr()->getTranslateY();
+                pair[0]->mInitPos.x += px;
+                pair[0]->mInitPos.y += py;
+                pair[0]->paneTrans(0.0f, 0.0f);
+                pair[1]->mInitPos.x -= px;
+                pair[1]->mInitPos.y -= py;
+                pair[1]->paneTrans(0.0f, 0.0f);
+            }
+        }
+        dusk::button_prompts::hud_layout_done(trade, dx, dy);
+    }
+#endif
