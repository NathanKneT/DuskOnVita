+#if TARGET_VITA
+// ke_set with --vita-fast-hair: off and on as the switch says; verify runs both (see above).
+static void twv_ke_set(e_s1_class* i_this) {
+    const int mode = twv_vita_fast_actor_mode(TWV_FAST_HAIR);
+    if (mode != 2) {
+        s_twvHairFast = mode == 1;
+        ke_set(i_this);
+        s_twvHairFast = 0;
+        return;
+    }
+    enum { STRANDS = 22, POINTS = 16 };
+    static s1_ke_s saved[STRANDS];
+    static s1_ke_s fastKe[STRANDS];
+    static cXyz fastPos[STRANDS][POINTS];
+    static f32 fastSize[STRANDS][POINTS];
+    int fastRnd[3];
+    int rnd[3];
+    Mtx fastAbove;
+    Mtx fastTop;
+    memcpy(saved, i_this->mKe, sizeof saved);
+    s_twvHairFast = 1;
+    ke_set(i_this);
+    s_twvHairFast = 0;
+    memcpy(fastKe, i_this->mKe, sizeof fastKe);
+    for (int i = 0; i < STRANDS; i++) {
+        memcpy(fastPos[i], i_this->mLineMat.getPos(i), sizeof fastPos[i]);
+        memcpy(fastSize[i], i_this->mLineMat.getSize(i), sizeof fastSize[i]);
+    }
+    twv_cM_rnd2_state(fastRnd);
+    MTXCopy(calc_mtx[1], fastAbove);
+    MTXCopy(*calc_mtx, fastTop);
+
+    memcpy(i_this->mKe, saved, sizeof saved);
+    ke_set(i_this); // the original, for the game
+
+    bool differ = memcmp(fastKe, i_this->mKe, sizeof fastKe) != 0;
+    for (int i = 0; i < STRANDS; i++) {
+        differ = differ || memcmp(fastPos[i], i_this->mLineMat.getPos(i), sizeof fastPos[i]) != 0 ||
+                 memcmp(fastSize[i], i_this->mLineMat.getSize(i), sizeof fastSize[i]) != 0;
+    }
+    twv_cM_rnd2_state(rnd);
+    differ = differ || memcmp(fastRnd, rnd, sizeof rnd) != 0 ||
+             memcmp(fastAbove, calc_mtx[1], sizeof fastAbove) != 0 ||
+             memcmp(fastTop, *calc_mtx, sizeof fastTop) != 0;
+    twv_vita_fast_actor_count(TWV_FAST_HAIR, 1, differ);
+}
+#endif
