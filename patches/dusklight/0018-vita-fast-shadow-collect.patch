+#ifndef D_VITA_SHADOW_FAST_H
+#define D_VITA_SHADOW_FAST_H
+
+// Vita (--vita-fast-shadow-collect, patches/dusklight/0018): real-time shadow ground polygon
+// collection with the same result. While realPolygonCheck walks the collision for one shadow on
+// the fast path, the walkers may
+//  - stop once the receiver list is full: from then on psdRealCallBack can only return through
+//    dDlst_shadowPoly_c::set's "mCount >= getTriMax()" exit or its own rejections, which change
+//    nothing, and the walkers themselves have no other effect;
+//  - skip a KC prism before building its vertices when psdRealCallBack would reject it on its
+//    light and plane tests (the same expressions on the same plane), which never read vertices.
+// Walk order, drawBits, through-checks, IsZero tests and vertex math are unchanged.
+#include "SSystem/SComponent/c_bg_s_shdw_draw.h"
+#include "SSystem/SComponent/c_m3d_g_pla.h"
+
+struct dVitaShadowFast_c {
+    const cBgS_ShdwDraw* mpOwner;
+    const u16* mpCount;
+    s32 mMax;
+    const cXyz* mpLight;
+    const cXyz* mpCenter;
+
+    bool full() const { return *mpCount >= mMax; }
+
+    // True when psdRealCallBack (d_drawlist.cpp) returns 1 without calling set() for this plane.
+    bool rejects(const cM3dGPla* plane) const {
+        const cXyz* normal = plane->GetNP();
+        if (mpLight->inprod(*normal) < -0.2f) {
+            const cXyz* center = mpCenter;
+            if (normal->x * center->x + normal->y * center->y + normal->z * center->z + plane->GetD() > -90.f) {
+                return false;
+            }
+        }
+        return true;
+    }
+};
+
+// Set by realPolygonCheck around one fast walk, NULL otherwise (game thread only).
+extern dVitaShadowFast_c* g_dVitaShadowFast;
+
+inline dVitaShadowFast_c* dVitaShadowFast_get(const cBgS_ShdwDraw* shdw) {
+    dVitaShadowFast_c* fast = g_dVitaShadowFast;
+    return fast != NULL && fast->mpOwner == shdw ? fast : NULL;
+}
+
+#endif /* D_VITA_SHADOW_FAST_H */
