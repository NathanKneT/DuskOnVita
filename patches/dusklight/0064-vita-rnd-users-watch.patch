             ret = fpcMtd_Execute((process_method_class DUSK_CONST*)actor->sub_method, actor);
 #if TARGET_VITA
             s_twvExecActor = twvPrevExec;
+            if (twvTrace) {
+                twv_rnd_trace = 0;
+                twv_vita_exec_rnd_trace(twv_rnd_trace_ra, twv_rnd_trace_n);
+            }
+            if (twv_draw_rnd_watch != 0 && twv_rnd_calls != twvRndBefore) {
