Vita: measurement only (the J3D probe build, TWV_VITA_J3D_PROBE). To split the joint calc's cost on
the console, whose clock is too coarse for one joint, the port repeats one step on sampled frames and
discards the copy, a different step per profile window (platform/vita/runtime/actor_profile.cpp):
1 the animation keyframe lookup (getTransform), 2 Euler angles to quaternion, 3 the joint's rotate /
translate matrix and its concatenation, 4 the weight envelope matrices (written again with the same
values). The growth of the window's J3D calc time is that step's cost. twv_j3d_probe_mode is 0 in
every other build and frame: one byte test per joint. No game behaviour changes: the game's own
calls, order and results are untouched; the copies go to scratch storage.

--- a/src/m_Do/m_Do_ext.cpp
+++ b/src/m_Do/m_Do_ext.cpp
@@ -32,6 +32,12 @@
 #include "dusk/interp/material.h"
 #include "dusk/logging.h"
 #include "dusk/version.hpp"
+#if TARGET_VITA
+// Vita (patches/dusklight/0036): measurement only. In the J3D probe build the port repeats one step
+// of the joint calc on sampled frames and discards the copy (twv_j3d_probe_mode 1-3); 0 otherwise.
+extern "C" unsigned char twv_j3d_probe_mode;
+static volatile float twvJ3dProbeSink;
+#endif
 #endif
 
 DUSK_GAME_DATA u8 mDoExt::CurrentHeapAdjustVerbose;
@@ -1744,6 +1750,23 @@
         if (mpCallback2 != NULL) {
             mpCallback2->execute(jnt_no);
         }
+#if TARGET_VITA
+        // Measurement only: the same step once more into scratch storage, its result discarded.
+        if (twv_j3d_probe_mode == 1 && mpAnm != NULL) {
+            J3DTransformInfo probe;
+            getTransform(jnt_no, &probe);
+            twvJ3dProbeSink = probe.mTranslate.x + probe.mScale.y + probe.mRotation.z;
+        } else if (twv_j3d_probe_mode == 2) {
+            Quaternion probe;
+            JMAEulerToQuat(trans_p->mRotation.x, trans_p->mRotation.y, trans_p->mRotation.z, &probe);
+            twvJ3dProbeSink = probe.x + probe.w;
+        } else if (twv_j3d_probe_mode == 3) {
+            Mtx probe;
+            J3DGetTranslateRotateMtx(*trans_p, probe);
+            MTXConcat(J3DSys::mCurrentMtx, probe, probe);
+            twvJ3dProbeSink = probe[0][0] + probe[2][3];
+        }
+#endif
     }
 }
 
