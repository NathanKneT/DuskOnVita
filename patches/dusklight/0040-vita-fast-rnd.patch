+#if TARGET_VITA
+// Vita (patches/dusklight/0040): --vita-fast-rnd=off|on|verify (platform/vita/runtime/fast_actors.hpp
+// "rnd"). cM_rnd and cM_rnd2 end with fabsf(fmodf(v, 1.0)), a libm call. fmodf is exact: for |v| < 1
+// it returns v, and for 1 <= |v| < 2^23 it returns v - trunc(v), which float subtraction gives exactly
+// (the difference is representable); fabsf drops the sign fmodf keeps. Larger values, infinities and
+// NaN keep the call. verify: both, compared bit for bit, the original returned.
+extern "C" {
+int twv_fast_rnd_mode = 0; // set by fast_actors.cpp
+void twv_vita_fast_actor_count(int which, int fast, int mismatch) __attribute__((weak));
+}
+enum { TWV_FAST_RND = 7 };
+
+static inline f32 twv_rnd_frac_fast(f32 v, f32 a) {
+    return a < 1.0f ? a : fabsf(v - (f32)(s32)v);
+}
+
+static f32 twv_rnd_frac(f32 v) {
+    const f32 a = fabsf(v);
+    if (twv_fast_rnd_mode == 1 && a < 8388608.0f) {
+        return twv_rnd_frac_fast(v, a);
+    }
+    const f32 ret = fabsf(fmodf(v, 1.0));
+    if (twv_fast_rnd_mode == 2 && twv_vita_fast_actor_count) {
+        const f32 fast = a < 8388608.0f ? twv_rnd_frac_fast(v, a) : ret;
+        u32 x, y;
+        memcpy(&x, &fast, sizeof x);
+        memcpy(&y, &ret, sizeof y);
+        twv_vita_fast_actor_count(TWV_FAST_RND, 1, x != y);
+    }
+    return ret;
+}
+#endif
+
 static s32 r0;
 
 static s32 r1;
