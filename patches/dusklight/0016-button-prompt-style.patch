--- /dev/null
+++ b/src/dusk/button_prompts.hpp
@@ -0,0 +1,109 @@
+#pragma once
+// Button prompt style, setting game.buttonPrompts: "gamecube" (the original art) or "playstation".
+// With "playstation" the button textures are swapped for glyphs the platform draws itself
+// (twilight-vita: platform/vita/ui/ps_glyphs.cpp): layout textures where a layout resolves them by
+// name (JUTResReference, J2DScreen::getNameResource), in-text icons by icon number
+// (COutFont_c::createPane). Only an explicit list of button textures is swapped, and only when the
+// texture came from an archive that holds that button and has the expected format and size;
+// everything else, and every build without platform glyphs, keeps the original resource.
+#include "dusk/settings.h"
+
+#if TARGET_VITA
+#include "JSystem/J2DGraph/J2DPicture.h"
+#include "JSystem/JKernel/JKRArchive.h"
+#include "JSystem/JUtility/JUTTexture.h"
+extern "C" int twv_ps_glyph_layout_listed(const char* name);
+extern "C" const void* twv_ps_glyph_layout(const char* name, const char* volume, const void* original);
+extern "C" const void* twv_ps_glyph_text(int index, int layer);
+extern "C" int twv_ps_glyph_hud_tint(const void* timg, unsigned* rgb);
+extern "C" void twv_ps_glyph_hud_tinted(const char* screen, int panes);
+#endif
+
+namespace dusk::button_prompts {
+
+inline bool playstation() {
+    return getSettings().game.buttonPrompts.getValue() == "playstation";
+}
+
+#if TARGET_VITA
+// The archive's root name (mVolumeName, e.g. "main2d"), read through a member pointer.
+struct VolumeName : JKRFileLoader {
+    static const char* of(JKRFileLoader* loader) { return loader->*(&VolumeName::mVolumeName); }
+};
+
+// Root name of the mounted archive that holds `res`, or nullptr.
+inline const char* owner_volume(const void* res) {
+    JSUList<JKRFileLoader>& volumes = JKRFileLoader::getVolumeList();
+    for (JSUListIterator<JKRFileLoader> it = volumes.getFirst(); it != volumes.getEnd(); ++it) {
+        JKRFileLoader* loader = it.operator->();
+        if (loader->getVolumeType() == 'RARC' && static_cast<JKRArchive*>(loader)->findPtrResource(res) != NULL) {
+            return VolumeName::of(loader);
+        }
+    }
+    return NULL;
+}
+#endif
+
+// Replacement for the layout texture `name` that resolved to `original`, or nullptr to keep it.
+inline void* layout_texture(const char* name, const void* original) {
+#if TARGET_VITA
+    if (!playstation() || !twv_ps_glyph_layout_listed(name)) {
+        return nullptr;
+    }
+    return const_cast<void*>(twv_ps_glyph_layout(name, owner_volume(original), original));
+#else
+    (void)name;
+    (void)original;
+    return nullptr;
+#endif
+}
+
+#if TARGET_VITA
+// Pictures whose texture has a HUD colour take it as their "white" (the colour a white texel
+// draws in), keeping its alpha and the "black". Returns how many panes changed.
+inline int recolor_panes(J2DPane* pane) {
+    int changed = 0;
+    for (J2DPane* child = pane->getFirstChildPane(); child != NULL; child = child->getNextChildPane()) {
+        if (child->getTypeID() == 18) { // J2DPicture, J2DPictureEx
+            J2DPicture* picture = static_cast<J2DPicture*>(child);
+            const JUTTexture* texture = picture->getTexture(0);
+            unsigned rgb = 0;
+            if (texture != NULL && twv_ps_glyph_hud_tint(texture->getTexInfo(), &rgb)) {
+                const JUtility::TColor white = picture->getWhite();
+                const JUtility::TColor tint(u8(rgb >> 16), u8(rgb >> 8), u8(rgb), white.a);
+                changed += picture->setBlackWhite(picture->getBlack(), tint) ? 1 : 0;
+            }
+        }
+        changed += recolor_panes(child);
+    }
+    return changed;
+}
+#endif
+
+// With "playstation", the main HUD's button bases turn dark and the face-button symbols take their
+// own colours (cross blue, circle red, square pink, triangle green), like the Vita's buttons. Called
+// once a HUD screen is built and coloured; colours only, no texture.
+inline void recolor_hud(J2DPane* screen, const char* label) {
+#if TARGET_VITA
+    if (screen == NULL || !playstation()) {
+        return;
+    }
+    twv_ps_glyph_hud_tinted(label, recolor_panes(screen));
+#else
+    (void)screen;
+    (void)label;
+#endif
+}
+
+// Replacement for in-text icon `index` (layer 1: the texture it blends with), or nullptr.
+inline void* text_icon(int index, int layer) {
+#if TARGET_VITA
+    return playstation() ? const_cast<void*>(twv_ps_glyph_text(index, layer)) : nullptr;
+#else
+    (void)index;
+    (void)layer;
+    return nullptr;
+#endif
+}
+
+} // namespace dusk::button_prompts
