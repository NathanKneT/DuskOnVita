--- /dev/null
+++ b/include/d/d_vita_actsub.h
@@ -0,0 +1,40 @@
+#ifndef D_VITA_ACTSUB_H
+#define D_VITA_ACTSUB_H
+
+// Vita (patches/dusklight/0030): measurement only. Execute detail for the main-thread actor profile
+// (platform/vita/runtime/actor_profile.cpp, actor_profile_stats.hpp Sub numbers): on sampled frames a
+// segment's time is charged to the executing process's profile; otherwise one flag test. No game
+// behaviour changes: same calls, same order, same results.
+#if TARGET_VITA
+extern "C" unsigned char twv_actsub_on;
+extern "C" unsigned long long twv_actsub_begin(unsigned sub);
+extern "C" void twv_actsub_end(unsigned sub, unsigned long long start);
+#define TWV_ACTSUB_BEGIN(sub) (twv_actsub_on ? twv_actsub_begin(sub) : 0ULL)
+#define TWV_ACTSUB_END(sub, start)                                                                 \
+    do {                                                                                           \
+        if ((start) != 0) {                                                                        \
+            twv_actsub_end((sub), (start));                                                        \
+        }                                                                                          \
+    } while (0)
+#else
+#define TWV_ACTSUB_BEGIN(sub) 0ULL
+#define TWV_ACTSUB_END(sub, start) ((void)(start))
+#endif
+
+enum {
+    TWV_ACTSUB_LINK_PRE = 16,
+    TWV_ACTSUB_LINK_ANIME = 17,
+    TWV_ACTSUB_LINK_PROC = 18,
+    TWV_ACTSUB_LINK_BG = 19,
+    TWV_ACTSUB_LINK_GROUND = 20,
+    TWV_ACTSUB_LINK_MATRIX = 21,
+    TWV_ACTSUB_LINK_TAIL = 22,
+    TWV_ACTSUB_METER_DRAW = 23,
+    TWV_ACTSUB_METER_MOVES = 24,
+    TWV_ACTSUB_METER_MAP = 25,
+    TWV_ACTSUB_METER_SUB = 26,
+    TWV_ACTSUB_CAMERA_RUN = 27,
+    TWV_ACTSUB_CAMERA_VIEW = 28,
+};
+
+#endif /* D_VITA_ACTSUB_H */
