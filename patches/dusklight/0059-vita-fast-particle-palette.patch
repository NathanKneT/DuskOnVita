+#if TARGET_VITA
+extern "C" void twv_vita_particle_batch_note(int outcome, int particles);
+// Vita (patches/dusklight/0059): --vita-fast-particle-palette (platform/vita/runtime/
+// visual_skips.hpp). The game draws each child particle as its own draw: one position matrix
+// loaded into slot 0, then the quad's display list. The console has ten position-matrix slots and
+// a per-vertex slot index (the path every skinned model uses). On, an emitter whose children need
+// nothing but their matrix (JPAResource.cpp checks the function list) keeps the matrices back and
+// sends up to ten children at once: matrix k into slot k, then one display list holding the same
+// quads, in the same order, each vertex with its slot index. Every vertex is still transformed by
+// its own particle's matrix, by the same shader arithmetic; only the number of draws changes.
+namespace {
+constexpr int kPaletteSlots = 10;
+struct PaletteLists {
+    alignas(32) u8 dl[2][kPaletteSlots][256];
+    u32 size[2][kPaletteSlots];
+    PaletteLists() {
+        // The quad's corners as jpa_dl and jpa_dl_x index them: position index, texcoord index.
+        static const u8 corners[2][8][2] = {
+            {{0, 0}, {1, 1}, {2, 2}, {3, 3}},
+            {{0, 0}, {1, 1}, {2, 2}, {3, 3}, {0x48, 0}, {0x49, 1}, {0x4A, 2}, {0x4B, 3}},
+        };
+        for (int cross = 0; cross < 2; cross++) {
+            const int perParticle = cross ? 8 : 4;
+            for (int n = 1; n <= kPaletteSlots; n++) {
+                u8* p = dl[cross][n - 1];
+                memset(p, 0, sizeof dl[cross][n - 1]);
+                const u32 count = (u32)(perParticle * n);
+                u32 at = 0;
+                p[at++] = 0x80; // GX_QUADS, GX_VTXFMT0
+                p[at++] = (u8)(count >> 8);
+                p[at++] = (u8)count;
+                for (int k = 0; k < n; k++) {
+                    for (int v = 0; v < perParticle; v++) {
+                        p[at++] = (u8)(3 * k); // GX_PNMTX0 + 3 * k
+                        p[at++] = corners[cross][v][0];
+                        p[at++] = corners[cross][v][1];
+                    }
+                }
+                size[cross][n - 1] = (at + 31) & ~31u;
+            }
+        }
+    }
+};
+} // namespace
+
+void JPAFlushParticlePalette(JPAEmitterWorkData* work, ParticleDrawCtx* ctx) {
+    (void)work;
+    if (ctx->paletteCount == 0) {
+        return;
+    }
+    static const PaletteLists lists;
+    for (int k = 0; k < ctx->paletteCount; k++) {
+        GXLoadPosMtxImm(ctx->paletteMtx[k], GX_PNMTX0 + 3 * k);
+    }
+    GXCallDisplayList(lists.dl[ctx->paletteCross][ctx->paletteCount - 1],
+                      lists.size[ctx->paletteCross][ctx->paletteCount - 1]);
+    twv_vita_particle_batch_note(6, ctx->paletteCount);
+    ctx->paletteCount = 0;
+}
+#endif
