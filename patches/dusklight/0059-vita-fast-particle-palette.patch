+#if TARGET_VITA
+// Vita (patches/dusklight/0059): --vita-fast-particle-palette. Children whose draw needs nothing
+// but their position matrix go out up to ten per draw (JPABaseShape.cpp). That is the case when
+// the child function list holds only quad draw functions that load one matrix and call the quad's
+// display list, and the particle callback hook with no callback set: no per-child colour, texture
+// or size call, no point or line shape.
+extern "C" int twv_fast_particle_palette_mode;
+
+static bool child_palette_ok(JPAEmitterWorkData* work, JPAResource::DrawParticleFunc* list, int count) {
+    if (twv_fast_particle_palette_mode == 0 || list == NULL || work->mPrjType != 0) {
+        return false;
+    }
+    bool hasDraw = false;
+    for (int i = 0; i < count; i++) {
+        JPAResource::DrawParticleFunc func = list[i];
+        if (func == JPADrawBillboard || func == JPADrawRotBillboard || func == JPADrawYBillboard ||
+            func == JPADrawRotYBillboard || func == JPADrawDirection || func == JPADrawRotDirection ||
+            func == JPADrawRotation)
+        {
+            hasDraw = true;
+        } else if (func == JPADrawParticleCallBack) {
+            if (work->mpEmtr->mpPtclCallBack != NULL) {
+                return false;
+            }
+        } else {
+            return false;
+        }
+    }
+    return hasDraw;
+}
+#endif
