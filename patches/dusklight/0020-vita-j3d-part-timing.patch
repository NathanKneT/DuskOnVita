+#if TARGET_VITA
+// Vita (patches/dusklight/0020): measurement only. On sampled frames the port times these five
+// parts (platform/vita/runtime/actor_profile.cpp); otherwise each pays one flag test.
+extern "C" unsigned char twv_j3d_prof_on;
+extern "C" unsigned long long twv_j3d_prof_begin(void);
+extern "C" void twv_j3d_prof_end(unsigned part, unsigned long long start);
+namespace {
+struct TwvJ3dPart {
+    explicit TwvJ3dPart(unsigned p) : part(p), start(twv_j3d_prof_on ? twv_j3d_prof_begin() : 0) {}
+    ~TwvJ3dPart() {
+        if (start != 0) {
+            twv_j3d_prof_end(part, start);
+        }
+    }
+    unsigned part;
+    unsigned long long start;
+};
+}  // namespace
+#define TWV_J3D_PART(p) TwvJ3dPart twvJ3dPart_(p)
+#else
+#define TWV_J3D_PART(p)
+#endif
