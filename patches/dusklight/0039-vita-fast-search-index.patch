+// Vita (patches/dusklight/0039): --vita-fast-search-index=off|on|verify, with the kept walk above.
+// fpcSch_JudgeByID and fpcSch_JudgeForPName return the first process of the walk with that ID or
+// name and change nothing, so an index of the kept walk (by name in walk order, and by ID) gives
+// the same answer without calling the judge for every process. fpcLyIt_AllJudgeNamed is for a judge
+// that returns NULL, with no side effect, for every process of another name (its call sites say
+// why): the judge runs on that name's processes only, in walk order, and once a judge changed a
+// list the search goes on as the original loop from that process. verify: the search as before for
+// the game, and the index's answer (named: its list of processes) compared with it.
+struct WalkIndex {
+    enum { ID_SLOTS = 4096 }; // a power of two, at least twice WalkKeep::MAX_TAGS
+    unsigned int byName[WalkKeep::MAX_TAGS]; // (u16 name << 16) | tag, ascending
+    fpc_ProcID ids[ID_SLOTS];
+    unsigned short idTag[ID_SLOTS]; // tag + 1, 0 empty
+    unsigned int serial;            // the s_walkKeepSerial it describes
+    bool built;
+};
+WalkIndex s_walkIndex;
+
+static unsigned int id_slot(fpc_ProcID id) {
+    return (id * 2654435761u) >> (32 - 12); // 12 bits: ID_SLOTS
+}
+
+static const WalkIndex* walk_index(const WalkKeep* keep) {
+    WalkIndex& x = s_walkIndex;
+    if (x.built && x.serial == s_walkKeepSerial) {
+        return &x;
+    }
+    memset(x.idTag, 0, sizeof x.idTag);
+    for (int tag = 0; tag < keep->tagCount; tag++) {
+        const base_process_class* proc = (const base_process_class*)keep->data[tag];
+        x.byName[tag] = ((unsigned int)(unsigned short)proc->name << 16) | (unsigned int)tag;
+        unsigned int slot = id_slot(proc->id);
+        while (x.idTag[slot] != 0 && x.ids[slot] != proc->id) {
+            slot = (slot + 1) & (WalkIndex::ID_SLOTS - 1);
+        }
+        if (x.idTag[slot] == 0) { // the first process with this ID in walk order
+            x.ids[slot] = proc->id;
+            x.idTag[slot] = (unsigned short)(tag + 1);
+        }
+    }
+    std::sort(x.byName, x.byName + keep->tagCount);
+    x.serial = s_walkKeepSerial;
+    x.built = true;
+    return &x;
+}
+
+// The first entry of name's processes in byName (end when none).
+static const unsigned int* name_first(const WalkIndex* x, int count, s16 name) {
+    const unsigned int key = (unsigned int)(unsigned short)name << 16;
+    const unsigned int* p = std::lower_bound(x->byName, x->byName + count, key);
+    return p != x->byName + count && (*p >> 16) == (key >> 16) ? p : x->byName + count;
+}
+
+// What fpcSch_JudgeByID / fpcSch_JudgeForPName over the kept walk returns.
+static void* index_find(const WalkKeep* keep, fpcLyIt_JudgeFunc func, void* data) {
+    const WalkIndex* x = walk_index(keep);
+    if (func == fpcSch_JudgeByID) {
+        const fpc_ProcID id = *(fpc_ProcID*)data;
+        for (unsigned int slot = id_slot(id); x->idTag[slot] != 0; slot = (slot + 1) & (WalkIndex::ID_SLOTS - 1)) {
+            if (x->ids[slot] == id) {
+                return keep->data[x->idTag[slot] - 1];
+            }
+        }
+        return NULL;
+    }
+    const unsigned int* p = name_first(x, keep->tagCount, *(s16*)data);
+    return p != x->byName + keep->tagCount ? keep->data[*p & 0xFFFF] : NULL;
+}
+
+static bool index_judge(fpcLyIt_JudgeFunc func) {
+    return func == fpcSch_JudgeByID || func == fpcSch_JudgeForPName;
+}
+
+// name's processes of the kept walk, in walk order, to the judge.
+static void* walk_named(const WalkKeep* keep, s16 name, layer_iter* iter) {
+    const WalkIndex* x = walk_index(keep);
+    const int count = keep->tagCount;
+    const unsigned int* end = x->byName + count;
+    const unsigned int generation = twv_cls_generation;
+    fpcLyIt_JudgeFunc func = (fpcLyIt_JudgeFunc)iter->func;
+    for (const unsigned int* p = name_first(x, count, name); p != end && (*p >> 16) == (unsigned short)name; ++p) {
+        const int tag = (int)(*p & 0xFFFF);
+        // Where the original loop would be at this process, read before the judge runs.
+        const int listNo = (int)(std::upper_bound(keep->listEnd, keep->listEnd + keep->listCount, tag) - keep->listEnd);
+        int a = 0, first = 0;
+        while (first + keep->layerListCount[a] <= listNo) {
+            first += keep->layerListCount[a++];
+        }
+        node_class* const next = tag + 1 < keep->listEnd[listNo] ? &keep->tags[tag + 1]->mpNode : NULL;
+        node_list_class* const listsA = keep->layerLists[a];
+        const int lists = keep->layerListCount[a];
+        layer_class* const layerA = keep->layers[a];
+        void* ret = func(keep->data[tag], iter->data);
+        if (ret != NULL) {
+            return ret;
+        }
+        if (twv_cls_generation != generation) {
+            return walk_resume(next, listsA, lists, listNo - first, layerA, iter);
+        }
+    }
+    return NULL;
+}
+
+// verify (named): the index lists exactly the kept walk's processes of that name, in walk order.
+static bool named_same(const WalkKeep* keep, s16 name) {
+    const WalkIndex* x = walk_index(keep);
+    const unsigned int* p = name_first(x, keep->tagCount, name);
+    const unsigned int* end = x->byName + keep->tagCount;
+    for (int tag = 0; tag < keep->tagCount; tag++) {
+        if (((const base_process_class*)keep->data[tag])->name != name) {
+            continue;
+        }
+        if (p == end || (*p >> 16) != (unsigned short)name || (int)(*p & 0xFFFF) != tag) {
+            return false;
+        }
+        ++p;
+    }
+    return p == end || (*p >> 16) != (unsigned short)name;
+}
 }  // namespace
 #endif
 
