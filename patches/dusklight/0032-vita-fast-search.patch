+#if TARGET_VITA
+// Vita (patches/dusklight/0032): --vita-fast-search, the actor queue's searches (fopAcM_SearchByID,
+// fopAcM_SearchByName, fopAcM_Search). Same rule as fpcLyIt_AllJudge (f_pc_layer_iter.cpp): the
+// queue's tags and tag data from one walk, handed to the judge from an array while no node list
+// anywhere changed (twv_cls_generation); once a judge changed one, the loop goes on as cNdIt_Judge
+// from the next node it had already read. verify: the original loop, and the kept array compared
+// with a fresh walk.
+#include "SSystem/SComponent/c_node.h"
+#include "SSystem/SComponent/c_tag.h"
+#include <string.h>
+extern "C" int twv_vita_fast_actor_mode(int which);
+extern "C" void twv_vita_fast_actor_count(int which, int fast, int mismatch);
+extern "C" unsigned int twv_cls_generation;
+
+namespace {
+enum { TWV_FAST_SEARCH = 1 };
+
+struct ActorQueueKeep {
+    enum { MAX_TAGS = 1024 };
+    create_tag_class* tags[MAX_TAGS];
+    void* data[MAX_TAGS];
+    int count;
+};
+
+ActorQueueKeep s_actorKeep;
+ActorQueueKeep s_actorFresh;
+unsigned int s_actorKeepGeneration;
+bool s_actorKeepValid = false;
+
+// cLsIt_Judge's order without judges: nothing when mSize is 0, else the head and its links.
+static bool actor_collect(ActorQueueKeep* keep) {
+    keep->count = 0;
+    if (g_fopAcTg_Queue.mSize > 0) {
+        for (node_class* node = g_fopAcTg_Queue.mpHead; node != NULL; node = node->mpNextNode) {
+            if (keep->count >= ActorQueueKeep::MAX_TAGS) {
+                return false;
+            }
+            keep->tags[keep->count] = (create_tag_class*)node;
+            keep->data[keep->count] = ((create_tag_class*)node)->mpTagData;
+            keep->count++;
+        }
+    }
+    return true;
+}
+
+static const ActorQueueKeep* actor_kept(bool* walked) {
+    *walked = false;
+    if (!s_actorKeepValid || s_actorKeepGeneration != twv_cls_generation) {
+        const unsigned int generation = twv_cls_generation;
+        s_actorKeepValid = actor_collect(&s_actorKeep);
+        s_actorKeepGeneration = generation;
+        *walked = true;
+    }
+    return s_actorKeepValid ? &s_actorKeep : NULL;
+}
+
+// Every entry is read before the judge runs (a judge's own search may take the kept walk again,
+// only once a list changed, and then this loop leaves the array at once).
+static void* actor_fast(const ActorQueueKeep* keep, fopAcIt_JudgeFunc func, void* userData) {
+    const unsigned int generation = twv_cls_generation;
+    const int count = keep->count;
+    for (int i = 0; i < count; i++) {
+        void* const data = keep->data[i];
+        node_class* node = i + 1 < count ? &keep->tags[i + 1]->mpNode : NULL;
+        void* ret = func(data, userData);
+        if (ret != NULL) {
+            return ret;
+        }
+        if (twv_cls_generation != generation) {
+            // cNdIt_Judge from the node it had already read as next, links read live.
+            node_class* pNext = NODE_GET_NEXT(node);
+            while (node) {
+                ret = func(((create_tag_class*)node)->mpTagData, userData);
+                if (ret != NULL) {
+                    return ret;
+                }
+                node = pNext;
+                pNext = NODE_GET_NEXT(pNext);
+            }
+            return NULL;
+        }
+    }
+    return NULL;
+}
+}  // namespace
+#endif
