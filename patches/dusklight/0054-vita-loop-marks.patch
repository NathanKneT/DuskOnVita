 // tick or the presentation draw (1 second tick, 2 presentation, 3 the one-tick-per-frame path).
 extern "C" void twv_vita_frame_overlap_settle(int site) __attribute__((weak));
+// Vita (patches/dusklight/0054, platform/vita/gfx_vgl/profile_hooks.cpp): marks between the main
+// loop's steps, so the receipts can time what runs outside the game tick and the painter (the
