+// reads the clock once; without the platform hook it does nothing.
+extern "C" void twv_vita_loop_mark(int mark) __attribute__((weak));
+#define TWV_LOOP_MARK(n) do { if (twv_vita_loop_mark) twv_vita_loop_mark(n); } while (0)
+#else
+#define TWV_LOOP_MARK(n) ((void)0)
 #endif
