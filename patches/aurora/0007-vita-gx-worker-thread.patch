+#if TWV_VITA_GFX_VGL
+void* vita_worker_entry(void*) {
+  if (twv_gx_worker_started) {
+    twv_gx_worker_started();
+  }
+  worker_run([] { return sVitaWorkerStop.load(std::memory_order_acquire); });
+  return nullptr;
+}
+
+bool worker_running() noexcept { return sVitaWorkerRunning; }
+
+void start_worker() {
+  if (kProcessingMode != ProcessingMode::Thread || sVitaWorkerRunning) {
+    return;
+  }
+  pthread_attr_t attr;
+  pthread_attr_init(&attr);
+  pthread_attr_setstacksize(&attr, kVitaWorkerStack);
+  sVitaWorkerStop.store(false, std::memory_order_release);
+  const int rc = pthread_create(&sVitaWorker, &attr, vita_worker_entry, nullptr);
+  pthread_attr_destroy(&attr);
+  AURORA_ASSERT(rc == 0, "fifo: failed to start the FIFO worker ({})", rc);
+  sVitaWorkerRunning = true;
+}
+
+void stop_worker() {
+  if (!sVitaWorkerRunning) {
+    return;
+  }
+  sVitaWorkerStop.store(true, std::memory_order_release);
+  wake_worker();
+  pthread_join(sVitaWorker, nullptr);
+  sVitaWorkerRunning = false;
+}
+#else
+void worker_main(std::stop_token token) noexcept {
+  std::stop_callback wakeOnStop{token, wake_worker};
+  worker_run([&] { return token.stop_requested(); });
+}
