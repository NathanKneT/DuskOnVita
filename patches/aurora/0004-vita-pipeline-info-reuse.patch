V59 Vita immutable pipeline ShaderInfo reuse candidate, runtime default OFF.

Adapted from the pipeline-info portion of the 3DS port's Aurora patch 0009.
Apply after patch 0003 to
Aurora 3227d76c60e1e782ca576610bce61c9e7744d8be; pristine command_processor.cpp
SHA256 ff3eeb1c06562c0cbbeb5cbad0daa45aeb4370733dd073ccd34f10f6303ba5ab.

OFF/REF preserves original builder-before-pipeline order. ON requests the
pipeline first and immediately copies its immutable info through a Vita
backend callback in the game/int-enum domain. Missing callback falls back to
the original builder. The backend validates full current PipelineConfig identity
and samples every semantic ShaderInfo field against the original config-only
builder on hit 1 and every 128th hit, independently of CACHE_VALIDATE. A real
backend mismatch disables the feature and aborts before submission because
frontend-only metadata fallback cannot restore cached backend derived state.
Existing texture-mask comparisons, uniform/immediate work and draw order remain.

--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -18,6 +18,14 @@
 #include <cstdint>
 #include <span>
 #include <vector>
+
+// Vita-only game/int-enum ABI; no game types enter the SDK bridge.
+#if TWV_VITA_GX_FAST_DECODE && !TWV_GX_DECODE_REF
+extern "C" int twv_vita_gx_fast_enabled(void) noexcept;
+extern "C" int twv_vita_pipeline_info_copy(uint32_t, const aurora::gx::PipelineConfig*,
+                                            aurora::gx::ShaderInfo*) noexcept __attribute__((weak));
+extern "C" void twv_vita_pipeline_info_built(int fallback) noexcept;
+#endif
 
 namespace aurora::gx::fifo {
 namespace {
@@ -405,8 +413,26 @@
     const auto prevSampledTextures = cache.shaderInfo.sampledTextures;
     const auto prevSampledIndTextures = cache.shaderInfo.sampledIndTextures;
     populate_pipeline_config(cache.config, prim, fmt);
-    cache.shaderInfo = build_shader_info(cache.config.shaderConfig);
-    cache.pipelineRef = gfx::pipeline_ref(cache.config);
+#if TWV_VITA_GX_FAST_DECODE && !TWV_GX_DECODE_REF
+    if (twv_vita_gx_fast_enabled()) {
+      // build_shader_info reads only config; pipeline_ref owns the same immutable info.
+      // Copy immediately: the backend pipeline vector can grow or clear afterwards.
+      cache.pipelineRef = gfx::pipeline_ref(cache.config);
+      if (!twv_vita_pipeline_info_copy ||
+          !twv_vita_pipeline_info_copy(cache.pipelineRef, &cache.config, &cache.shaderInfo)) {
+        cache.shaderInfo = build_shader_info(cache.config.shaderConfig);
+        twv_vita_pipeline_info_built(1);
+      }
+    } else
+#endif
+    {
+      // Preserve the original build-before-pipeline order when unselected/compiled out.
+      cache.shaderInfo = build_shader_info(cache.config.shaderConfig);
+#if TWV_VITA_GX_FAST_DECODE && !TWV_GX_DECODE_REF
+      twv_vita_pipeline_info_built(0);
+#endif
+      cache.pipelineRef = gfx::pipeline_ref(cache.config);
+    }
     cache.targetLayoutKey = targetLayoutKey;
