+#if defined(__vita__)
+// Vita (patches/aurora/0025): --vita-fast-reg-repeats=off|on|verify (platform/vita/runtime/
+// fast_painter.hpp). Two kinds of register load reach their handlers although they change nothing
+// (register census: 2,400 of 7,900 BP writes and 2,100 of
+// 5,200 XF loads per frame in Kakariko):
+//  - BP 0xE0-0xE7 hold a TEV colour register or a konst colour, told apart by bit 23 of the value.
+//    The BP shadow keeps one value per address, and J3D sends the colour and then the konst of the
+//    same address with every material, so each write differs from the other kind's and is decoded
+//    again. Here the last decoded value is kept per address and kind.
+//  - Light loads (XF 0x600-0x67F, several words) are decoded and compared field by field; the same
+//    lights are sent with every material. Here the raw words last decoded are kept.
+// On: a write equal to the kept value is not handed to its handler. For BP the shadow, its valid
+// bit and the uniform flag are set as the handler would; for a light load the handler changes
+// nothing when the values are equal. Verify: the handler still runs and the colour registers,
+// konst colours or lights are compared before and after; a change is counted as a mismatch.
+struct RegRepeats {
+  int mode = -1;        // -1 not read yet, 0 off, 1 on, 2 verify
+  u32 tev[2][8] = {};   // [kind][address - 0xE0]: value as handle_bp decoded it (register in the top byte)
+  u8 tevValid[2] = {};  // one bit per address
+  u32 light[0x80] = {}; // raw words in FIFO byte order
+  u8 lightValid[0x80] = {};
+  u32 counts[4] = {};   // BP writes not decoded, light loads not decoded, BP mismatches, light mismatches
+};
+extern RegRepeats gRegRepeats;
+int reg_repeats_mode() noexcept;
+// The write or load was dealt with (on: nothing to do; verify: handler run and checked).
+void bp_tev_repeat_done(u32 value) noexcept;
+void xf_light_repeat_done(u16 addr, std::span<const u8> data) noexcept;
+
+ALWAYS_INLINE bool reg_repeats_on() noexcept {
+  const int mode = gRegRepeats.mode;
+  return (mode < 0 ? reg_repeats_mode() : mode) != 0;
+}
+ALWAYS_INLINE bool bp_tev_reg_repeat(u32 value) noexcept {
+  const u32 regId = value >> 24;
+  if ((regId & 0xF8) != 0xE0) {
+    return false;
+  }
+  const auto& r = gRegRepeats;
+  const u32 kind = (value >> 23) & 1;
+  const u32 i = regId & 7;
+  return g_gxState.bpRegCache[0xFE] == 0x00FFFFFF && ((r.tevValid[kind] >> i) & 1) != 0 && r.tev[kind][i] == value;
+}
+ALWAYS_INLINE bool xf_light_repeat(u32 addr, const u8* words, u32 count) noexcept {
+  const u32 base = addr - 0x600;
+  if (base >= 0x80 || count > 0x80 - base) {
+    return false;
+  }
+  const auto& r = gRegRepeats;
+  for (u32 i = 0; i < count; ++i) {
+    u32 w;
+    std::memcpy(&w, words + i * 4, 4);
+    if (r.lightValid[base + i] == 0 || r.light[base + i] != w) {
+      return false;
+    }
+  }
+  return true;
+}
+#endif
+
 #endif
 
