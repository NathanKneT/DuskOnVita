+// --vita-fast-gx-wake (patches/aurora/0020, platform/vita/runtime/fast_painter.hpp): the same wakes
+// at the same points (every publish wakes a sleeping worker, every processed range wakes a waiting
+// game thread), each a fence and a flag test and, only for a thread that is really asleep, one
+// semaphore signal. std::atomic wait/notify (off) costs a counter update, a shared waiter-pool mutex
+// and a condition broadcast per call on this pthread layer, and the game thread publishes after
+// every draw. A sleeper raises its flag, then re-reads what it waits for (the published position and
+// the stop flag, or the processed position) and only then blocks; the waker changes that, then reads
+// the flag and takes it to signal (a seq_cst fence between the write and the read on both sides, so
+// one of them sees the other). verify (2): sleeps are timed, and a sleeper that still holds its flag
+// two timeouts after what it waits for changed counts a lost wakeup.
+extern "C" int twv_gx_fast_wake_mode() noexcept __attribute__((weak));
+int sFastWake = 0;
+SceUID sWorkerSema = -1, sWaiterSema = -1;
+std::atomic<uint32_t> sWorkerSleeping{0}, sWaiterSleeping{0};
+// Counts: [0] worker signals, [1] worker sleeps, [2] waiter signals, [3] waiter sleeps, [4] lost.
+std::atomic<uint32_t> sFastWakeCounts[5]{};
+constexpr SceUInt kVerifyTimeoutUs = 2000;
+
+void count_wake(unsigned i) noexcept { sFastWakeCounts[i].fetch_add(1, std::memory_order_relaxed); }
+
+// After what the sleeper waits for has changed: wake it if it raised its flag.
+void fast_signal(std::atomic<uint32_t>& sleeping, SceUID sema, unsigned counter) noexcept {
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  if (sleeping.load(std::memory_order_relaxed) != 0 && sleeping.exchange(0, std::memory_order_acq_rel) != 0) {
+    sceKernelSignalSema(sema, 1);
+    count_wake(counter);
+  }
+}
+
+// Sleeps until signalled unless changed() already holds after the flag is raised. A signal that
+// arrives after the sleeper gave up on sleeping only causes one early return of a later sleep.
+template <typename Changed>
+void fast_sleep(std::atomic<uint32_t>& sleeping, SceUID sema, unsigned counter, Changed&& changed) noexcept {
+  sleeping.store(1, std::memory_order_relaxed);
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  if (changed()) {
+    sleeping.exchange(0, std::memory_order_acq_rel);
+    return;
+  }
+  count_wake(counter);
+  if (sFastWake != 2) {
+    sceKernelWaitSema(sema, 1, nullptr);
+    return;
+  }
+  unsigned movedTimeouts = 0;
+  while (true) {
+    SceUInt timeout = kVerifyTimeoutUs;
+    if (sceKernelWaitSema(sema, 1, &timeout) >= 0) {
+      return;
+    }
+    if (!changed()) {
+      movedTimeouts = 0;
+      continue;
+    }
+    // The waker takes the flag before it signals: still holding it a whole timeout after the
+    // change was seen means no signal is on its way.
+    if (++movedTimeouts >= 2 && sleeping.exchange(0, std::memory_order_acq_rel) != 0) {
+      count_wake(4);
+      return;
+    }
+  }
+}
 #endif
 
