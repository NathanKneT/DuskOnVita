+/**
+ * twilight-vita: process a display list in place instead of a copy of it (GXCallDisplayListStatic).
+ * Must be followed by a u64 list address, a u32 byte size, a u32 list id (unchanged while the list's
+ * bytes are) and a u32 check hash (0: none).
+ */
+#define GX_AURORA_CALL_DL_STATIC 0x0042
+
 #define GX2_SET_POLYGON_OFFSET 0x1000
 
 
+/*
+ * twilight-vita: display lists the caller keeps unchanged and alive until the frame's
+ * commands are processed (J3D's shape display lists). GXCallDisplayListStatic queues a reference
+ * instead of copying the list; GXInvalidateDisplayListStatic must follow every change to such a
+ * list's bytes (including a new list allocated at the address of a freed one). Elsewhere, and while
+ * a display list is being recorded, GXCallDisplayListStatic is GXCallDisplayList.
+ */
+void GXCallDisplayListStatic(const void* list, u32 nbytes);
+void GXInvalidateDisplayListStatic(const void* list);
+
+/*
+ * twilight-vita: an array whose bytes its owner changes in place from now on (J3D's vertex
+ * buffers name theirs whenever they swap them). The Vita backend takes an array loaded from a static
+ * display list as unchanged while that list's id holds, except an array named here: that one it
+ * reads anew every frame.
+ */
+void GXInvalidateArrayStatic(const void* array);
