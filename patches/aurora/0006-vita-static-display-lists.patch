@@ -5,6 +5,41 @@
 
 #include <cstring>
 
+#if defined(__vita__)
+#include <atomic>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <xxhash.h>
+
+namespace {
+// GXCallDisplayListStatic: an id per list, new whenever the list may have changed. Lists are normally
+// made and drawn on the main thread; the lock covers a model built elsewhere.
+std::mutex sStaticListMutex;
+struct StaticList {
+  u32 size;
+  u32 id;
+  u32 hash;  // verify mode: the bytes' hash when the id was given (0 otherwise)
+};
+std::unordered_map<const void*, StaticList> sStaticLists;
+u32 sStaticListId = 0;
+constexpr size_t MaxStaticLists = 16384;  // past this, start over (every list gets a new id)
+// GXInvalidateArrayStatic: arrays changed in place (same lock). A new entry moves the generation on;
+// starting over moves the epoch on as well (the backend then forgets every array it took as unchanged).
+std::unordered_set<const void*> sDynamicArrays;
+std::atomic<u32> sDynamicArrayGen{1};
+u32 sDynamicArrayEpoch = 0;
+constexpr size_t MaxDynamicArrays = 4096;
+} // namespace
+
+// platform/vita/gfx_vgl (weak: absent without the Vita backend): the start-up mode, 0 off (every
+// list is copied, as upstream does), 1 by reference, 2 by reference with each list's hash checked at
+// the call and at its processing; and verify mode's report of a list whose bytes changed without an
+// invalidation.
+extern "C" int twv_gx_static_dl_mode() noexcept __attribute__((weak));
+extern "C" void twv_gfx_static_dl_changed() noexcept __attribute__((weak));
+#endif
+
 static __GXData_struct sSavedGXData;
 
 extern "C" {
@@ -62,4 +97,86 @@ void GXCallDisplayList(const void* data, u32 nbytes) {
   aurora::gx::fifo::publish();
 }
 
+void GXCallDisplayListStatic(const void* data, u32 nbytes) {
+#if defined(__vita__)
+  const int mode = twv_gx_static_dl_mode ? twv_gx_static_dl_mode() : 0;
+  if (mode == 0 || aurora::gx::fifo::in_display_list() || nbytes == 0) {
+    GXCallDisplayList(data, nbytes);
+    return;
+  }
+  if (__gx->dirtyState != 0) {
+    __GXSetDirtyState();
+  }
+  if (*reinterpret_cast<u32*>(&__gx->vNum) != 0) {
+    __GXSendFlushPrim();
+  }
+  u32 id;
+  u32 hash;
+  {
+    std::lock_guard lock{sStaticListMutex};
+    if (sStaticLists.size() >= MaxStaticLists) {
+      sStaticLists.clear();
+    }
+    auto& list = sStaticLists[data];
+    hash = 0;
+    if (mode == 2) {
+      hash = XXH32(data, nbytes, 0) | 1;
+      if (list.id != 0 && list.size == nbytes && list.hash != hash && twv_gfx_static_dl_changed) {
+        twv_gfx_static_dl_changed();
+      }
+    }
+    if (list.id == 0 || list.size != nbytes || list.hash != hash) {
+      list = {nbytes, ++sStaticListId, hash};
+    }
+    id = list.id;
+  }
+  GX_WRITE_AURORA(GX_AURORA_CALL_DL_STATIC);
+  GX_WRITE_U64(reinterpret_cast<uintptr_t>(data));
+  GX_WRITE_U32(nbytes);
+  GX_WRITE_U32(id);
+  GX_WRITE_U32(hash);
+  aurora::gx::fifo::publish();
+#else
+  GXCallDisplayList(data, nbytes);
+#endif
+}
+
+void GXInvalidateDisplayListStatic(const void* data) {
+#if defined(__vita__)
+  std::lock_guard lock{sStaticListMutex};
+  sStaticLists.erase(data);
+#else
+  (void)data;
+#endif
+}
+
+void GXInvalidateArrayStatic(const void* array) {
+#if defined(__vita__)
+  std::lock_guard lock{sStaticListMutex};
+  if (sDynamicArrays.size() >= MaxDynamicArrays) {
+    sDynamicArrays.clear();
+    ++sDynamicArrayEpoch;
+    sDynamicArrayGen.fetch_add(1, std::memory_order_release);
+  }
+  if (sDynamicArrays.insert(array).second) {
+    sDynamicArrayGen.fetch_add(1, std::memory_order_release);
+  }
+#else
+  (void)array;
+#endif
+}
+
+#if defined(__vita__)
+// platform/vita/gfx_vgl: whether GXInvalidateArrayStatic named an array, with the generation and epoch
+// the answer holds for; and the generation alone, without the lock. An array named after the answer
+// moves the generation on before its new bytes are written.
+bool twv_gx_array_dynamic(const void* array, u32* gen, u32* epoch) noexcept {
+  std::lock_guard lock{sStaticListMutex};
+  *gen = sDynamicArrayGen.load(std::memory_order_relaxed);
+  *epoch = sDynamicArrayEpoch;
+  return sDynamicArrays.count(array) != 0;
+}
+u32 twv_gx_array_gen() noexcept { return sDynamicArrayGen.load(std::memory_order_acquire); }
+#endif
+
 }
