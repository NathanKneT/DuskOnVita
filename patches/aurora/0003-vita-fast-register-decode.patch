+// Portable unchanged-write tests adapted from the committed 3DS patch.
+// 1 for the BP registers whose unchanged write handle_bp ignores; 0 for the mask register (0xFE),
+// the registers handled on every write (EFB copy and TLUT load triggers) and DRAWDONE (process() returns
+// after it).
+extern const std::array<u8, 0x100> kBpSkipUnchanged;
+// 1 for the CP registers whose unchanged write handle_cp ignores.
+extern const std::array<u8, 0x100> kCpSkipUnchanged;
+
+// True when handle_bp(value) would change nothing: no BP mask pending (the merged value is then `value`
+// itself), the register holds `value` already and handle_bp ignores an unchanged write to it.
+ALWAYS_INLINE bool bp_write_unchanged(u32 value) noexcept {
+  const u32 regId = value >> 24;
+  const auto& state = g_gxState;
+  return kBpSkipUnchanged[regId] != 0 && state.bpRegCache[0xFE] == 0x00FFFFFF && state.bpRegCache[regId] == value &&
+         state.bpRegValid[regId];
+}
+
+// True when handle_cp(addr, value) would change nothing.
+ALWAYS_INLINE bool cp_write_unchanged(u8 addr, u32 value) noexcept {
+  const auto& state = g_gxState;
+  return kCpSkipUnchanged[addr] != 0 && state.cpRegCache[addr] == value && state.cpRegValid[addr];
+}
+
+// True when handle_xf(addr, one word `value`) would change nothing: an XF register outside the viewport
+// and projection blocks (decoded as a whole) that holds `value` already.
+ALWAYS_INLINE bool xf_write_unchanged(u32 addr, u32 value) noexcept {
+  const u32 reg = addr - 0x1000;
+  const auto& state = g_gxState;
+  return reg < XfRegCount && reg - 0x1A > 0x26 - 0x1A && state.xfRegCache[reg] == value && state.xfRegValid[reg];
+}
