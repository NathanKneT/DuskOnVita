+static ProcessResult process_fast(const u8* data, u32 size) noexcept {
+  u32 pos = 0;
+  while (pos != size) {
+    const u8* const p = data + pos;
+    const u32 avail = size - pos;
+    const u32 op = p[0] >> 3;
