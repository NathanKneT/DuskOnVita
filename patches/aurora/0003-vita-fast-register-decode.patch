+#if TWV_VITA_GX_FAST_DECODE && !TWV_GX_DECODE_REF
+// Choose the byte order once per XF memory load; preserve all stored float bits.
+template <bool Swap>
+ALWAYS_INLINE u32 xf_word(const u8* data) noexcept {
+  const u32 v = unaligned_load<u32>(data);
+  return Swap ? bswap(v) : v;
+}
+
+// Stores one word's bits into *dst; returns the bits that changed.
+template <bool Swap>
+ALWAYS_INLINE u32 store_xf_word(f32* dst, const u8* data) noexcept {
+  const u32 v = xf_word<Swap>(data);
+  u32 old;
+  std::memcpy(&old, dst, sizeof(old));
+  std::memcpy(dst, &v, sizeof(v));
+  return old ^ v;
+}
+
+// `len` words into consecutive floats (position, texture and post-transform matrices).
+template <bool Swap>
+bool store_xf_words(f32* dst, const u8* data, u32 len) noexcept {
+  u32 diff = 0;
+  u32 i = 0;
+  for (; i + 4 <= len; i += 4) {
+    diff |= store_xf_word<Swap>(dst + i, data + i * 4);
+    diff |= store_xf_word<Swap>(dst + i + 1, data + i * 4 + 4);
+    diff |= store_xf_word<Swap>(dst + i + 2, data + i * 4 + 8);
+    diff |= store_xf_word<Swap>(dst + i + 3, data + i * 4 + 12);
+  }
+  for (; i < len; ++i) {
+    diff |= store_xf_word<Swap>(dst + i, data + i * 4);
+  }
+  return diff != 0;
+}
+
+// Normal matrices: 3x3 source words into 3x4 storage.
+template <bool Swap>
+bool store_xf_nrm(f32* flat, const u8* data, u32 len) noexcept {
+  u32 diff = 0;
+  if (len == 9) {
+    for (u32 row = 0; row < 3; ++row) {
+      diff |= store_xf_word<Swap>(flat + row * 4, data + row * 12);
+      diff |= store_xf_word<Swap>(flat + row * 4 + 1, data + row * 12 + 4);
+      diff |= store_xf_word<Swap>(flat + row * 4 + 2, data + row * 12 + 8);
+    }
+  } else {
+    for (u32 i = 0; i < len; i++) {
+      diff |= store_xf_word<Swap>(flat + (i / 3) * 4 + i % 3, data + i * 4);
+    }
+  }
+  return diff != 0;
+}
+
+// Light fields from startOffset (the original's switch, with the stores above).
+template <bool Swap>
+bool store_xf_light(Light& light, u32 startOffset, const u8* data, u32 len) noexcept {
+  u32 diff = 0;
+  for (u32 i = 0; i < len; i++) {
+    const u8* word = data + i * 4;
+    switch (startOffset + i) {
+    case 3: { // Color (packed u32)
+      const Vec4<float> color = unpack_color(xf_word<Swap>(word));
+      if (memcmp(&light.color, &color, sizeof(color)) != 0) {
+        light.color = color;
+        diff |= 1;
+      }
+      break;
+    }
+    case 4:
+      diff |= store_xf_word<Swap>(&light.cosAtt[0], word);
+      break; // a0
+    case 5:
+      diff |= store_xf_word<Swap>(&light.cosAtt[1], word);
+      break; // a1
+    case 6:
+      diff |= store_xf_word<Swap>(&light.cosAtt[2], word);
+      break; // a2
+    case 7:
+      diff |= store_xf_word<Swap>(&light.distAtt[0], word);
+      break; // k0
+    case 8:
+      diff |= store_xf_word<Swap>(&light.distAtt[1], word);
+      break; // k1
+    case 9:
+      diff |= store_xf_word<Swap>(&light.distAtt[2], word);
+      break; // k2
+    case 10:
+      diff |= store_xf_word<Swap>(&light.pos[0], word);
+      break; // px
+    case 11:
+      diff |= store_xf_word<Swap>(&light.pos[1], word);
+      break; // py
+    case 12:
+      diff |= store_xf_word<Swap>(&light.pos[2], word);
+      break; // pz
+    case 13:
+      diff |= store_xf_word<Swap>(&light.dir[0], word);
+      break; // nx
+    case 14:
+      diff |= store_xf_word<Swap>(&light.dir[1], word);
+      break; // ny
+    case 15:
+      diff |= store_xf_word<Swap>(&light.dir[2], word);
+      break; // nz
+    default:
+      break; // padding (0-2)
+    }
+  }
+  return diff != 0;
+}
