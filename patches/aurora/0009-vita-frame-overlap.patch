+#if defined(__vita__)
+// Vita frame overlap (patches/aurora/0009, --vita-frame-overlap): the game thread ends a frame
+// without waiting for the worker and settles it later, before anything that may change what the
+// frame's commands read.
+// publish_frame: publishes every buffered byte (a frame is never ended inside a display list) and
+//   returns the stream position the frame ends at.
+// close_frame: ends the frame for publish()/finish_draw() only; end_frame() still runs at settle,
+//   when the worker no longer uses the draw cache.
+// note_draw_done: GXSetDrawDone's position, so the frame end can wait for the draw-done callback
+//   only (draw_done_mark), as early in the frame as the game put it.
+// wait_processed: blocks until the worker has processed up to target (which must be published).
+// settle_frame: wait_processed(end), then drops the processed bytes; bytes written after end (the
+//   next frame's, unpublished between frames) move to the front and keep their stream positions.
+// wait_us: game-thread time spent blocked on the worker so far (drain and the waits above).
+uint64_t publish_frame() noexcept;
+void close_frame() noexcept;
+void note_draw_done() noexcept;
+uint64_t draw_done_mark() noexcept;
+void wait_processed(uint64_t target) noexcept;
+void settle_frame(uint64_t end) noexcept;
+uint64_t wait_us() noexcept;
+#endif
