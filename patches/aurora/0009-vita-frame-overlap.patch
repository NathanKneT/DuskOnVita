+uint64_t draw_done_mark() noexcept { return sDrawDoneMark; }
+
+void wait_processed(uint64_t target) noexcept {
+  AURORA_ASSERT(target <= sPublished.load(std::memory_order_relaxed),
+                "fifo::wait_processed: position {} is not published ({})", target,
+                sPublished.load(std::memory_order_relaxed));
+  uint64_t processed = sProcessed.load(std::memory_order_acquire);
+  if (processed >= target) {
+    return;
+  }
+  const uint64_t waitStart = wait_clock();
+  do {
+    sProcessed.wait(processed, std::memory_order_acquire);
+    processed = sProcessed.load(std::memory_order_acquire);
+  } while (processed < target);
+  sWaitUs += wait_clock() - waitStart;
+}
+
+void settle_frame(uint64_t end) noexcept {
+  wait_processed(end);
+  std::unique_lock lock{sBufferMutex, std::defer_lock};
+  if (kProcessingMode != ProcessingMode::Inline) lock.lock();
+  AURORA_ASSERT(sPublished.load(std::memory_order_relaxed) == end && end >= sStreamBase &&
+                    end <= sStreamBase + detail::sBufferSize,
+                "fifo::settle_frame: frame end {} outside [{}, {}] or not the last published position {}", end,
+                sStreamBase, sStreamBase + detail::sBufferSize, sPublished.load(std::memory_order_relaxed));
+  const auto done = static_cast<uint32_t>(end - sStreamBase);
+  const uint32_t tail = detail::sBufferSize - done;
+  if (tail != 0 && done != 0) {
+    std::memmove(detail::sBufferData, detail::sBufferData + done, tail);
+  }
+  sStreamBase = end;
+  detail::sBufferSize = tail;
+  sPendingDraws = 0;
+}
+
+uint64_t wait_us() noexcept { return sWaitUs; }
+#endif
+
 const uint8_t* get_buffer_data() { return detail::sBufferData; }
 uint32_t get_buffer_size() { return detail::sBufferSize; }
 
