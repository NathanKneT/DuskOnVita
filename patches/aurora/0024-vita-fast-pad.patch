+// Vita (--vita-fast-pad=off|on|verify, platform/vita/runtime/fast_actors.hpp switch 9). PADRead
+// asks SDL for about forty buttons and axes per game tick, one locked call each. SDL's gamepad
+// state changes only while SDL pumps events (window::poll_events, this thread), so between two
+// pumps every such call returns the same value. The fast path keeps, per port, the values asked
+// since the last pump: a button or an axis is asked from SDL at most once per pump (a stick's
+// positive and negative directions read one axis; a second game tick in the frame asks nothing),
+// and a button the pad's SDL mapping does not have reads up without asking (SDL_GamepadHasButton,
+// kept until a pad is added, removed or remapped). Verify asks SDL every time as before, uses its
+// answer and counts the reads where the kept value differed.
+//
+// --vita-fast-pad-events=off|on|verify (switch 10, with --vita-fast-pad on): the kept values are
+// no longer dropped at every pump. SDL changes a gamepad button or axis and posts its event in the
+// same step, and window::process_event hands every event to pad_memo_event below before PADRead
+// runs, so a kept value is brought up to date by its event and SDL is asked only for a value not
+// seen since the pad was added or remapped. Verify asks SDL every time, uses its answer and counts
+// the reads where the value kept from events differed.
+extern "C" {
+int twv_vita_fast_actor_mode(int which) __attribute__((weak));
+void twv_vita_fast_actor_count(int which, int fast, int mismatch) __attribute__((weak));
+}
+namespace {
+constexpr int TWV_FAST_PAD_SWITCH = 9;
+constexpr int TWV_FAST_PAD_EVENTS_SWITCH = 10;
+struct PadMemo {
+  const SDL_Gamepad* pad = nullptr;
+  uint32_t pump = 0, mapping = 0;
+  uint32_t hasKnown = 0, has = 0, buttonKnown = 0, buttonDown = 0, axisKnown = 0;
+  std::array<Sint16, SDL_GAMEPAD_AXIS_COUNT> axis{};
+};
+static_assert(SDL_GAMEPAD_BUTTON_COUNT <= 32 && SDL_GAMEPAD_AXIS_COUNT <= 32);
+std::array<PadMemo, PAD_CHANMAX> g_padMemo;
+int g_padFastMode = 0;          // this PADRead: 0 off, 1 on, 2 verify
+int g_padEventsMode = 0;        // the last PADRead: 0 values dropped at each pump, 1 kept from events, 2 verify
+bool g_padMemoRefilled = false; // this PADRead asked SDL for a value
+bool g_padMemoMismatch = false; // verify: a kept value differed from SDL's
+
+PadMemo& pad_memo(const aurora::input::GameController* controller, const uint32_t port) {
+  PadMemo& memo = g_padMemo[port];
+  if (memo.pad != controller->m_controller || memo.mapping != aurora::input::g_padMappingGeneration) {
+    memo = {};
+    memo.pad = controller->m_controller;
+    memo.mapping = aurora::input::g_padMappingGeneration;
+    memo.pump = aurora::input::g_padPumpGeneration;
+  } else if (memo.pump != aurora::input::g_padPumpGeneration) {
+    memo.pump = aurora::input::g_padPumpGeneration;
+    if (g_padEventsMode == 0) {
+      memo.buttonKnown = memo.axisKnown = 0;
+    }
+  }
+  return memo;
+}
+
+// One gamepad button or axis event: the value SDL now answers for it, on every port that keeps
+// values for that pad.
+void pad_memo_update(const SDL_Gamepad* pad, const int button, const bool down, const int axis, const Sint16 value) {
+  for (PadMemo& memo : g_padMemo) {
+    if (memo.pad != pad || memo.mapping != aurora::input::g_padMappingGeneration) {
+      continue;
+    }
+    if (button >= 0 && button < SDL_GAMEPAD_BUTTON_COUNT) {
+      const uint32_t bit = 1u << button;
+      memo.buttonKnown |= bit;
+      memo.buttonDown = down ? (memo.buttonDown | bit) : (memo.buttonDown & ~bit);
+    }
+    if (axis >= 0 && axis < SDL_GAMEPAD_AXIS_COUNT) {
+      memo.axisKnown |= 1u << axis;
+      memo.axis[axis] = value;
+    }
+  }
+}
+
+bool pad_button(const aurora::input::GameController* controller, const uint32_t port, const int button) {
+  const auto native = static_cast<SDL_GamepadButton>(button);
+  if (g_padFastMode == 0) {
+    return SDL_GetGamepadButton(controller->m_controller, native);
+  }
+  bool down = false;
+  if (button >= 0 && button < SDL_GAMEPAD_BUTTON_COUNT) {
+    PadMemo& memo = pad_memo(controller, port);
+    const uint32_t bit = 1u << button;
+    if (!(memo.hasKnown & bit)) {
+      memo.hasKnown |= bit;
+      if (SDL_GamepadHasButton(controller->m_controller, native)) {
+        memo.has |= bit;
+      }
+    }
+    if (memo.has & bit) {
+      if (!(memo.buttonKnown & bit)) {
+        memo.buttonKnown |= bit;
+        memo.buttonDown &= ~bit;
+        if (SDL_GetGamepadButton(controller->m_controller, native)) {
+          memo.buttonDown |= bit;
+        }
+        g_padMemoRefilled = true;
+      }
+      down = (memo.buttonDown & bit) != 0;
+    }
+  }
+  if (g_padFastMode == 2 || g_padEventsMode == 2) {
+    const bool reference = SDL_GetGamepadButton(controller->m_controller, native);
+    if (reference != down) {
+      g_padMemoMismatch = true;
+    }
+    return reference;
+  }
+  return down;
+}
+
+Sint16 pad_axis(const aurora::input::GameController* controller, const uint32_t port, const int axis) {
+  const auto native = static_cast<SDL_GamepadAxis>(axis);
+  if (g_padFastMode == 0 || axis < 0 || axis >= SDL_GAMEPAD_AXIS_COUNT) {
+    return SDL_GetGamepadAxis(controller->m_controller, native);
+  }
+  PadMemo& memo = pad_memo(controller, port);
+  const uint32_t bit = 1u << axis;
+  if (!(memo.axisKnown & bit)) {
+    memo.axisKnown |= bit;
+    memo.axis[axis] = SDL_GetGamepadAxis(controller->m_controller, native);
+    g_padMemoRefilled = true;
+  }
+  if (g_padFastMode == 2 || g_padEventsMode == 2) {
+    const Sint16 reference = SDL_GetGamepadAxis(controller->m_controller, native);
+    if (reference != memo.axis[axis]) {
+      g_padMemoMismatch = true;
+    }
+    return reference;
+  }
+  return memo.axis[axis];
+}
+} // namespace
+
+namespace aurora::input {
+void pad_memo_event(const SDL_Event& event) noexcept {
+  if (event.type == SDL_EVENT_GAMEPAD_ADDED || event.type == SDL_EVENT_GAMEPAD_REMOVED ||
+      event.type == SDL_EVENT_GAMEPAD_REMAPPED) {
+    ++g_padMappingGeneration;
+    return;
+  }
+  if (g_padEventsMode == 0) {
+    return;
+  }
+  if (event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN || event.type == SDL_EVENT_GAMEPAD_BUTTON_UP) {
+    pad_memo_update(SDL_GetGamepadFromID(event.gbutton.which), event.gbutton.button,
+                    event.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN, -1, 0);
+  } else if (event.type == SDL_EVENT_GAMEPAD_AXIS_MOTION) {
+    pad_memo_update(SDL_GetGamepadFromID(event.gaxis.which), -1, false, event.gaxis.axis, event.gaxis.value);
+  }
+}
