+// short-circuits it (numChans / numTexGens equal to the state's value). With verify it returns
+// false and says in `revalidated` whether on would have short-circuited it.
+inline bool xf_gen_mode_short(u32 reg, u32 val, bool& revalidated) noexcept {
+  revalidated = false;
+  if ((reg != 0x09 && reg != 0x3F) || gen_mode_fast() == 0) {
+    return false;
+  }
+  const auto& state = g_gxState;
+  const bool same = reg == 0x09 ? state.numChans == static_cast<decltype(state.numChans)>(val) :
+                                  state.numTexGens == static_cast<decltype(state.numTexGens)>(val);
+  if (!same) {
