+// What bp_gen_mode decodes from `value`, against the state.
+inline bool gen_mode_is_state(u32 value) noexcept {
+  const auto& state = g_gxState;
+  const u32 hwCull = reg_get(value, 2, 14);
+  const GXCullMode cull = hwCull == GX_CULL_FRONT  ? GX_CULL_BACK :
+                          hwCull == GX_CULL_BACK   ? GX_CULL_FRONT :
+                                                     static_cast<GXCullMode>(hwCull);
+  return state.numTexGens == static_cast<decltype(state.numTexGens)>(reg_get(value, 4, 0)) &&
+         state.numChans == static_cast<decltype(state.numChans)>(reg_get(value, 3, 4)) &&
+         state.numTevStages == static_cast<decltype(state.numTevStages)>(reg_get(value, 4, 10) + 1) &&
+         state.cullMode == cull &&
