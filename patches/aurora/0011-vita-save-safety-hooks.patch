+void CardGciFolder::before_change(GciFile& file, const char* reason) {
+  // Once per open...close cycle: a game save is one CARDOpen, several CARDWrites and a status
+  // commit, and only the version before the first of them is worth keeping. A change to a file
+  // that is not open (delete, rename, status) is announced every time.
+  if (aurora_card_gci_before_change == nullptr || (file.opened && file.changeAnnounced)) {
+    return;
+  }
+  file.changeAnnounced = file.opened;
+  const auto folder = io::fs_path_to_string(m_folderPath);
+  const std::string name{reinterpret_cast<const char*>(file.filename.data()), file.filename.size()};
+  aurora_card_gci_before_change(folder.c_str(), name.c_str(), reason);
+}
